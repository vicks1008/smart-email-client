generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountProvider {
  MICROSOFT
  ARCHIVE
  APPLE_MAIL
}

enum AccountStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
}

enum MailboxKind {
  PRIMARY
  SHARED
}

enum MailboxRole {
  PERSONAL
  SHARED
  TEAM
}

enum SyncJobStatus {
  QUEUED
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum SyncTrigger {
  MANUAL
  OAUTH_CALLBACK
  POLL
}

enum ImportFormat {
  EML
  OLM
}

enum ImportJobStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum OrganizationKind {
  INTERNAL
  CLIENT
  VENDOR
  LEAD
  UNKNOWN
}

enum MessageCategoryLabel {
  CLIENT
  LEAD
  VENDOR
  INTERNAL
  BILLING
  SUPPORT
  NEWSLETTER
  NOTIFICATION
}

enum MessageCategorySource {
  DOMAIN
  SIGNATURE
  THREAD_HISTORY
  HEURISTIC
  MANUAL
  MODEL
}

enum ReplyStateStatus {
  NEEDS_REPLY
  WAITING_ON_THEM
  CLOSED_LOOP
  FOLLOW_UP_LATER
}

enum FollowUpTaskStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum FollowUpTaskSource {
  AUTO
  MANUAL
}

model OAuthState {
  id               String          @id @default(cuid())
  state            String          @unique
  provider         AccountProvider
  postAuthRedirect String?
  createdAt        DateTime        @default(now())
}

model AppSettings {
  id           String   @id @default(cuid())
  singletonKey String   @unique @default("default")
  models       Json
  accounts     Json
  workflows    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id               String          @id @default(cuid())
  provider         AccountProvider
  status           AccountStatus   @default(ACTIVE)
  tenantId         String?
  externalUserId   String
  email            String
  displayName      String?
  scopes           String?
  accessToken      String?         @db.Text
  refreshToken     String?         @db.Text
  tokenExpiresAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  mailboxes        Mailbox[]
  syncJobs         SyncJob[]
  importJobs       ImportJob[]

  @@unique([provider, externalUserId])
}

model Mailbox {
  id                  String      @id @default(cuid())
  accountId           String
  externalId          String
  emailAddress        String
  displayName         String
  kind                MailboxKind
  role                MailboxRole @default(PERSONAL)
  ownerOrganizationId String?
  ownerContactId      String?
  deltaLink           String?     @db.Text
  lastSyncedAt        DateTime?
  lastSyncError       String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  account             Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerOrganization   Organization? @relation("MailboxOrganization", fields: [ownerOrganizationId], references: [id], onDelete: SetNull)
  ownerContact        Contact?    @relation("MailboxOwnerContact", fields: [ownerContactId], references: [id], onDelete: SetNull)
  threads             Thread[]
  messages            Message[]
  replyStates         ReplyState[]
  followUpTasks       FollowUpTask[]
  syncJobs            SyncJob[]
  importJobs          ImportJob[]
  thunderbirdSyncSource ThunderbirdSyncSource?

  @@unique([accountId, externalId])
  @@unique([accountId, emailAddress])
  @@index([ownerOrganizationId])
  @@index([ownerContactId])
}

model ThunderbirdSyncSource {
  id                    String   @id @default(cuid())
  mailboxId             String   @unique
  thunderbirdAccountId  String
  thunderbirdAccountName String
  thunderbirdIdentityId String?
  thunderbirdIdentityEmail String?
  thunderbirdIdentityName String?
  daysBack              Int      @default(45)
  maxMessagesPerFolder  Int      @default(250)
  enabled               Boolean  @default(true)
  lastSyncedAt          DateTime?
  lastSyncError         String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  mailbox               Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([enabled, lastSyncedAt])
  @@index([thunderbirdAccountId])
}

model Thread {
  id                     String     @id @default(cuid())
  mailboxId              String
  externalConversationId String
  subject                String
  participants           Json
  unreadCount            Int        @default(0)
  lastMessageAt          DateTime
  archivedAt             DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  mailbox                Mailbox    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messages               Message[]
  participantsExpanded   ThreadParticipant[]
  messageCategories      MessageCategory[]
  replyState             ReplyState?
  followUpTasks          FollowUpTask[]

  @@unique([mailboxId, externalConversationId])
  @@index([mailboxId, lastMessageAt(sort: Desc)])
  @@index([mailboxId, archivedAt, lastMessageAt(sort: Desc)])
}

model Message {
  id                String    @id @default(cuid())
  mailboxId         String
  threadId          String
  externalMessageId String
  internetMessageId String?
  subject           String
  fromName          String?
  fromAddress       String?
  toRecipients      Json
  ccRecipients      Json
  receivedAt        DateTime
  sentAt            DateTime?
  bodyPreview       String
  bodyText          String    @db.Text
  bodyHtml          String?   @db.Text
  webLink           String?
  importance        String?
  isRead            Boolean   @default(false)
  hasAttachments    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  mailbox           Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  thread            Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  category          MessageCategory?

  @@unique([mailboxId, externalMessageId])
  @@index([threadId, receivedAt(sort: Desc)])
}

model Organization {
  id                String            @id @default(cuid())
  name              String
  normalizedName    String            @unique
  primaryDomain     String?
  kind              OrganizationKind  @default(UNKNOWN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contacts          Contact[]
  mailboxes         Mailbox[]         @relation("MailboxOrganization")
  threadParticipants ThreadParticipant[]
  messageCategories MessageCategory[]
  followUpTasks     FollowUpTask[]

  @@index([primaryDomain])
  @@index([kind, name])
}

model Contact {
  id                 String                @id @default(cuid())
  organizationId     String?
  displayName        String
  normalizedName     String
  roleTitle          String?
  isMailboxOwner     Boolean               @default(false)
  lastSeenAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  emailAddresses     ContactEmailAddress[]
  threadParticipants ThreadParticipant[]
  ownedMailboxes     Mailbox[]             @relation("MailboxOwnerContact")
  followUpTasks      FollowUpTask[]

  @@index([organizationId, normalizedName])
  @@index([normalizedName])
}

model ContactEmailAddress {
  id           String   @id @default(cuid())
  contactId    String
  emailAddress String   @unique
  domain       String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([domain])
}

model ThreadParticipant {
  id             String        @id @default(cuid())
  threadId       String
  contactId      String?
  organizationId String?
  emailAddress   String
  displayName    String?
  isMailbox      Boolean       @default(false)
  isSharedMailbox Boolean      @default(false)
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  thread         Thread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([threadId, emailAddress])
  @@index([contactId])
  @@index([organizationId])
}

model MessageCategory {
  id             String                @id @default(cuid())
  messageId      String                @unique
  threadId       String
  organizationId String?
  label          MessageCategoryLabel
  confidence     Float
  source         MessageCategorySource
  isUserOverride Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  message        Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  thread         Thread                @relation(fields: [threadId], references: [id], onDelete: Cascade)
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([threadId, label])
  @@index([organizationId, label])
}

model ReplyState {
  id                  String           @id @default(cuid())
  threadId            String           @unique
  mailboxId           String
  status              ReplyStateStatus
  reason              String
  confidence          Float
  needsReply          Boolean          @default(false)
  waitingOnThem       Boolean          @default(false)
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  replyDueAt          DateTime?
  staleAt             DateTime?
  suggestedFollowUpAt DateTime?
  isOverdue           Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  thread              Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailbox             Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId, status, replyDueAt])
  @@index([mailboxId, isOverdue, suggestedFollowUpAt])
}

model FollowUpTask {
  id             String             @id @default(cuid())
  threadId       String
  mailboxId      String
  organizationId String?
  contactId      String?
  source         FollowUpTaskSource
  status         FollowUpTaskStatus @default(PENDING)
  title          String
  note           String?
  dueAt          DateTime
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  thread         Thread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailbox        Mailbox            @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact        Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([mailboxId, status, dueAt])
  @@index([threadId, status])
  @@index([organizationId, status, dueAt])
}

model SyncJob {
  id          String        @id @default(cuid())
  accountId   String
  mailboxId   String
  status      SyncJobStatus @default(QUEUED)
  trigger     SyncTrigger
  startedAt   DateTime?
  finishedAt  DateTime?
  errorText   String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mailbox     Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ImportJob {
  id               String          @id @default(cuid())
  accountId        String
  mailboxId        String
  format           ImportFormat
  sourceFilename   String
  importedMessages Int             @default(0)
  status           ImportJobStatus @default(IN_PROGRESS)
  startedAt        DateTime        @default(now())
  finishedAt       DateTime?
  errorText        String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mailbox          Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}
